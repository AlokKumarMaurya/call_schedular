<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/callmate_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@android:color/white">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CALLMATE" android:textAllCaps="true" android:textSize="11sp" android:textStyle="bold" android:textColor="@android:color/darker_gray" />
    <TextView android:id="@+id/callmate_widget_next_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:ellipsize="end" android:maxLines="1" android:text="No upcoming calls" android:textSize="19sp" android:textStyle="bold" android:textColor="@android:color/black" />
    <TextView android:id="@+id/callmate_widget_next_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="end" android:maxLines="1" android:text="Open Callmate to schedule a call" android:textSize="13sp" android:textColor="@color/callmate_widget_text_secondary" />
    <TextView android:id="@+id/callmate_widget_next_phone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1" android:text="" android:textSize="12sp" android:textColor="@color/callmate_widget_text_secondary" />
    <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <TextView android:id="@+id/callmate_widget_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0 upcoming" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/callmate_widget_text_primary" />
</LinearLayout>
